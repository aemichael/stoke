{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STOKE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/stoke",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug STOKE with args",
            "type": "cppdbg", 
            "request": "launch",
            "program": "${workspaceFolder}/bin/stoke",
            "args": ["${input:stokeArgs}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing", 
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ],
    "inputs": [
        {
            "id": "stokeArgs",
            "type": "promptString",
            "description": "Arguments to pass to stoke"
        }
    ]
}